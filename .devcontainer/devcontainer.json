{
  "name": "elTAHFIDH (situs statis + plugin WordPress)",
  "image": "mcr.microsoft.com/devcontainers/php:8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Pratinjau situs",
      "onAutoForward": "notify"
    }
  },
  "onCreateCommand": "cd wp-content/plugins/my-custom-app && composer install --no-interaction --no-progress || echo '[setup] composer install dilewati, jalankan manual bila perlu'",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "remoteUser": "vscode"
}
